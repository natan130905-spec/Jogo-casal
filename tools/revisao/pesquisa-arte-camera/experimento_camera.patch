+  // ---------- EXPERIMENTO: câmera por jogador ----------
+  private cam = { x: 0, y: 0, anc: 0, ahead: 0, alt: ALT_BASE, ini: false };
+  private cameraNova(e: Estado, dt: number) {
+    const eu = e.jogadores[EU], ou = e.jogadores[1 - EU], c = this.cam;
+    const meia = (h: number) => 1 - Math.exp(-dt * 0.6931 / h);
+    if (!c.ini) { c.anc = eu.y; c.x = eu.x; }
+    // âncora vertical: só muda ao pousar (o pulo não balança a câmera) ou se sair da faixa [-0,8; +2,4] m
+    if (eu.noChao) c.anc += (eu.y - c.anc) * meia(0.18);
+    else if (eu.y > c.anc + 2.4) c.anc = eu.y - 2.4;
+    else if (eu.y < c.anc - 0.8) c.anc = eu.y + 0.8;
+    // olhar à frente: 1,0 m parado, até 1,8 m correndo, para o lado em que olha
+    const frente = eu.olhando * (1.0 + Math.min(1, Math.abs(eu.vx) / 5) * 0.8);
+    c.ahead += (frente - c.ahead) * meia(0.45);
+    let fx = eu.x + c.ahead, fy = c.anc, alt = ALT_BASE;
+    const asp = this.camera.aspect;
+    const dx = ou.x - eu.x, dy = ou.y - eu.y;
+    // parceiro perto: enquadra os dois (afasta até 14 %); longe: só eu + indicador na borda
+    if (!ou.bolha && Math.abs(dx) < 12 && Math.abs(dy) < 4.5) {
+      const V = Math.max(1.1 / ALT_BASE, (Math.abs(dx) + 4.5) / asp, Math.abs(dy) + 3.2);
+      alt = Math.max(0.14, 1.1 / V);
+      const peso = Math.min(1, Math.max(0, (12 - Math.abs(dx)) / 4)); // entra/sai suave entre 8 e 12 m
+      fx = eu.x + c.ahead * (1 - 0.5 * peso) + dx * 0.5 * peso;
+      fy = c.anc + Math.max(-1.5, Math.min(1.5, dy * 0.5)) * peso;
+      alt = ALT_BASE + (alt - ALT_BASE) * peso;
+    }
+    c.alt += (alt - c.alt) * meia(0.6);
+    // zona morta horizontal de ±0,35 m
+    const zx = fx - c.x, zm = 0.35;
+    if (Math.abs(zx) > zm) c.x += (zx - Math.sign(zx) * zm) * meia(0.14);
+    c.y += (fy - c.y) * meia(0.25);
+    if (!c.ini) { c.x = fx; c.y = fy; c.alt = alt; c.ini = true; }
+    const V = 1.1 / c.alt, tg = Math.tan(THREE.MathUtils.degToRad(this.camera.fov / 2));
+    const dist = V / (2 * tg);
+    // pés a ~30 % da altura da tela: centro do quadro 0,2·V acima dos pés (+0,1 m)
+    const cy = c.y + 0.2 * V + 0.1;
+    if (V2) {
+      // câmera na altura do olhar (vê a face dos barrancos, o chão vira uma faixa, como na arte conceitual);
+      // os pés ficam a 30 % da altura da tela por deslocamento de lente (sem inclinar a câmera)
+      this.camera.position.set(c.x, c.y + OLHO, dist);
+      this.camera.lookAt(c.x, c.y + OLHO, 0);
+      this.camera.updateProjectionMatrix();
+      this.camera.projectionMatrix.elements[9] = 0.4 - 2 * OLHO / V; // pés em NDC −0,4
+      this.camera.projectionMatrixInverse.copy(this.camera.projectionMatrix).invert();
+      return;
+    }
+    this.camera.position.set(c.x, cy + 0.7, dist);
+    this.camera.lookAt(c.x, cy, 0);
+  }
+
+  /** EXPERIMENTO: projeta um ponto do mundo para coordenadas normalizadas da tela (-1..1). */
+  projetar(x: number, y: number, z = 0) { const v = new THREE.Vector3(x, y, z).project(this.camera); return { x: v.x, y: v.y }; }
+
+  /** EXPERIMENTO: camada de primeiro plano escurecida (folhagem entre a câmera e o plano de jogo), 1 chamada. */
+  private primeiroPlano() {
+    const r = sorteio(77), geos: THREE.BufferGeometry[] = [];
+    for (let x = -10; x < this.fase.largura + 10; x += 6 + r() * 7) {
+      let topo = -1; for (const q of this.chao) if (x >= q.x && x <= q.x + q.w) topo = Math.max(topo, q.y + q.h);
+      const z = 3.0 + r() * 1.6, base = topo - 1.5 - r() * 0.5;
+      const n = 3 + Math.floor(r() * 3);
+      for (let k = 0; k < n; k++) {
+        const g = new THREE.IcosahedronGeometry(0.7 + r() * 0.8, 1);
+        colocar(g, x + (k - n / 2) * 0.9 + r() * 0.4, base + r() * 0.9, z + r() * 0.4, [1.3, 0.8 + r() * 0.5, 0.6]);
+        geos.push(pintar(g, 0x22143c));
+      }
+      if (r() < 0.55) { // folha alta (samambaia) que sobe pela borda do quadro
+        for (let f = 0; f < 4; f++) {
+          const g = new THREE.ConeGeometry(0.18, 2.4 + r() * 1.2, 4, 1);
+          colocar(g, x + 1.2 + f * 0.25, base + 1.6, z + 0.2, [1, 1, 0.3], [0, 0, (f - 1.5) * 0.28]);
+          geos.push(pintar(g, 0x1a1030));
+        }
+      }
+    }
+    const m = new THREE.Mesh(mergeGeometries(geos.map((g) => g.index ? g.toNonIndexed() : g))!, new THREE.MeshBasicMaterial({ vertexColors: true, fog: false }));
+    m.frustumCulled = false;
+    return m;
+  }
+
   info() { const r = this.renderer.info.render; return { chamadas: r.calls, triangulos: r.triangles }; }
 }
